---
layout: null
---
{%- assign photo_files = site.static_files | where_exp: "file", "file.path contains '/assets/photos/'" | where_exp: "file", "file.extname == '.jpg' or file.extname == '.jpeg' or file.extname == '.png' or file.extname == '.gif' or file.extname == '.webp'" | sort: "name" -%}
[
{%- for photo in photo_files -%}
{"name":{{ photo.name | jsonify }},"url":{{ photo.path | relative_url | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]